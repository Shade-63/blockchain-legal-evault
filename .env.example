# Legal eVault - Environment Configuration Template
# Copy this file to .env and configure the variables accordingly.

# Application Settings
APP_ENV=development
DEBUG=true
JWT_SECRET=your_super_secret_jwt_key_here_must_be_changed

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/evault

# Storage Configuration (MinIO / S3 Compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=evault-documents

# Blockchain Configuration (EVM Node / Hardhat)
BLOCKCHAIN_RPC_URL=http://localhost:8545
# Standard Hardhat Local Node Account #0 Private Key (for local development only)
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Public Verification base URL (where the verification portal UI runs)
PUBLIC_VERIFY_BASE_URL=http://localhost:5173

# Skip connection verification on startup (useful in offline testing environments)
BYPASS_STARTUP_VALIDATION=false
